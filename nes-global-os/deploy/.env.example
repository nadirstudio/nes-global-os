# Copy to .env (install.sh does this and fills the secrets). Never commit .env.
NES_ENV=production
NES_SITE_ROLE=local
NES_TIMEZONE=Asia/Karachi
NES_DEFAULT_CURRENCY=PKR
# Public address served by Caddy. ":80" = office LAN only. A domain = automatic HTTPS.
NES_SITE_ADDRESS=:80
# Set true once served over HTTPS (domain or Tailscale), so session cookies are HTTPS-only.
NES_COOKIE_SECURE=false

# Generated by install.sh
POSTGRES_PASSWORD=
NES_JWT_SECRET=
NES_MASTER_KEY=

# Optional: AI provider keys as environment variables (otherwise add them in Settings → AI).
# NES_ANTHROPIC_API_KEY=
# NES_OPENAI_API_KEY=
# NES_GEMINI_API_KEY=

# NES Team Android app: the app's web origin. Leave as is unless told otherwise.
NES_CORS_ORIGINS=https://localhost

# Calls: group size limit and optional TURN relay (not needed on office Wi-Fi or Tailscale)
# NES_CALL_MAX_GROUP=6
# NES_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"nes","credential":"secret"}]
